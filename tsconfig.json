{
    "extends": "@oathompsonjones/ts-config",
    "compilerOptions": {
        "module": "esnext",
        "moduleResolution": "Bundler",
        "skipLibCheck": true,
        "noEmit": true,
        "incremental": true,
        "plugins": [
            {
                "name": "next",
            },
        ],
        "paths": {
            "app/*": [
                "./src/app/*"
            ],
            "pages/*": [
                "./src/app/(pages)/*"
            ],
            "api/*": [
                "./src/app/api/*"
            ],
            "assets/*": [
                "./src/assets/*"
            ],
            "components/*": [
                "./src/components/*"
            ],
            "contexts/*": [
                "./src/contexts/*"
            ],
            "hooks/*": [
                "./src/hooks/*"
            ],
            "styles/*": [
                "./src/styles/*"
            ],
            "actions/*": [
                "./src/actions/*"
            ],
            "public/*": [
                "./public/*"
            ],
        },
    },
    "include": [
        "next-env.d.ts",
        "**/*.ts",
        "**/*.tsx",
        ".next/types/**/*.ts",
    ],
    "exclude": [
        "node_modules",
        ".next",
    ],
}